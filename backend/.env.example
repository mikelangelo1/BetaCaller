# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=betacaller
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Apple Sign In Configuration
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=your-apple-private-key
APPLE_CALLBACK_URL=http://localhost:3000/api/auth/apple/callback

# Frontend URL
FRONTEND_URL=http://localhost:3000

# ===========================================
# VoIP Provider Configuration
# ===========================================

# VoIP Provider Settings
# Default provider: 'voximplant', 'twilio', or 'telnyx'
VOIP_DEFAULT_PROVIDER=voximplant
# Priority order for failover (comma-separated)
VOIP_PROVIDER_ORDER=voximplant,twilio,telnyx
# Max failures before switching to next provider
VOIP_MAX_FAILURES=3
# Enable automatic failover between providers
VOIP_AUTO_FAILOVER=true

# -------------------------------------------
# Voximplant Configuration (Primary)
# -------------------------------------------
VOXIMPLANT_ACCOUNT_ID=your_voximplant_account_id
VOXIMPLANT_ACCOUNT_NAME=your_account_name.voximplant.com
VOXIMPLANT_API_KEY=your_voximplant_api_key
VOXIMPLANT_APPLICATION_ID=your_application_id
VOXIMPLANT_APPLICATION_NAME=your_application_name
VOXIMPLANT_RULE_NAME=your_rule_name
VOXIMPLANT_CALLER_NUMBER=+1234567890
VOXIMPLANT_WEBHOOK_SECRET=your_voximplant_webhook_secret

# -------------------------------------------
# Twilio Configuration (Secondary)
# -------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_API_KEY_SID=your_twilio_api_key_sid
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret
TWILIO_TWIML_APP_SID=your_twiml_app_sid
TWILIO_CALLER_NUMBER=+1234567890
TWILIO_WEBHOOK_SECRET=your_twilio_webhook_secret

# -------------------------------------------
# Telnyx Configuration (Tertiary/Backup)
# -------------------------------------------
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here
TELNYX_APP_ID=your_telnyx_app_id_here
TELNYX_CONNECTION_ID=your_connection_id_here
TELNYX_PHONE_NUMBER=+1234567890
TELNYX_WEBHOOK_SECRET=your_webhook_secret_here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Initial User Balance (in USD)
INITIAL_BALANCE=10.00

# Default Call Rate (per minute in USD)
DEFAULT_CALL_RATE=0.012

# Payment Gateway Configuration
# Paystack (for Nigerian Naira payments)
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# Stripe (for USD payments)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Currency Exchange Rate (NGN to USD)
# You can also fetch this from an external API
NGN_TO_USD_RATE=1650
